SYSTEM_ONE_ENVIRONMENT=development
SYSTEM_ONE_LOG_LEVEL=INFO
SYSTEM_ONE_HOST=0.0.0.0
SYSTEM_ONE_PORT=8000
SYSTEM_ONE_API_KEY=local-dev-key

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=System One Router

# Jev decision engine. Authentication reuses OPENROUTER_API_KEY above.
JEV_ENABLED=false
JEV_MODEL=~typesafe/jev-latest
JEV_BASE_URL=https://openrouter.ai/api/alpha
JEV_TIMEOUT_SECONDS=10
